{
  "$description": "Compa brand tokens: palette, semantic roles, typography, and fixed mark geometry. provenance.json records which consumers use them; a consumer that is not listed there has not adopted them.",
  "color": {
    "palette": {
      "cobalt": {
        "$type": "color",
        "$value": "#3D63D8",
        "$description": "Primary identity and selected action"
      },
      "deep": {
        "$type": "color",
        "$value": "#2749AD",
        "$description": "Strong accent, core, and primary hover state"
      },
      "darkSurfaceText": {
        "$type": "color",
        "$value": "#9CABFF",
        "$description": "Brand and readable secondary text on Core Night"
      },
      "soft": {
        "$type": "color",
        "$value": "#E8ECFF",
        "$description": "Inverse wordmark and high-emphasis dark-surface content"
      },
      "coreNight": {
        "$type": "color",
        "$value": "#111215",
        "$description": "Dark canvas and icon tile"
      },
      "canvas": {
        "$type": "color",
        "$value": "#F7F5EF",
        "$description": "Warm primary light canvas"
      },
      "surface": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Raised light surface"
      },
      "ink": {
        "$type": "color",
        "$value": "#171719",
        "$description": "Primary light-surface text"
      },
      "muted": {
        "$type": "color",
        "$value": "#666976",
        "$description": "Secondary light-surface text"
      },
      "line": {
        "$type": "color",
        "$value": "#D9D7D0",
        "$description": "Light-surface border and divider"
      }
    },
    "semantic": {
      "light": {
        "background": "{color.palette.canvas}",
        "surface": "{color.palette.surface}",
        "text": "{color.palette.ink}",
        "textMuted": "{color.palette.muted}",
        "border": "{color.palette.line}",
        "brand": "{color.palette.cobalt}",
        "brandStrong": "{color.palette.deep}",
        "onBrand": "{color.palette.surface}"
      },
      "dark": {
        "background": "{color.palette.coreNight}",
        "surface": "{color.palette.ink}",
        "surfaceRaised": "{color.palette.ink}",
        "surfaceSelected": "{color.palette.deep}",
        "text": "{color.palette.soft}",
        "textMuted": "{color.palette.darkSurfaceText}",
        "border": "{color.palette.muted}",
        "brand": "{color.palette.darkSurfaceText}",
        "brandStrong": "{color.palette.soft}",
        "onBrand": "{color.palette.coreNight}"
      },
      "focusRing": "{color.palette.cobalt}",
      "selection": "{color.palette.cobalt}"
    }
  },
  "typography": {
    "sans": {
      "$type": "fontFamily",
      "$value": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "ui-monospace, 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "display": 680
    }
  },
  "mark": {
    "fixedGeometry": {
      "viewBox": "0 0 100 100",
      "outerOpenC": "M72 20 H36 C27.16 20 20 27.16 20 36 V64 C20 72.84 27.16 80 36 80 H72 V68 H38 C34.69 68 32 65.31 32 62 V38 C32 34.69 34.69 32 38 32 H72 Z",
      "inner": "M66 38 H46 C41.58 38 38 41.58 38 46 V54 C38 58.42 41.58 62 46 62 H66 V53 H48 C46.9 53 46 52.1 46 51 V49 C46 47.9 46.9 47 48 47 H66 Z",
      "innerOpacity": 0.48,
      "core": {
        "element": "rect",
        "x": 72,
        "y": 44,
        "width": 12,
        "height": 12,
        "rx": 2.5
      }
    },
    "color": {
      "primaryOuter": "{color.palette.cobalt}",
      "primaryInner": "{color.palette.deep}",
      "primaryCore": "{color.palette.deep}",
      "inverseOuter": "{color.palette.darkSurfaceText}",
      "inverseInner": "{color.palette.soft}",
      "inverseCore": "{color.palette.soft}"
    },
    "clearSpace": {
      "$type": "number",
      "$value": 0.12,
      "$description": "One core width, expressed as a fraction of the master viewBox"
    },
    "minimumSize": {
      "markDigital": "16px",
      "applicationIconDigital": "32px",
      "lockupDigitalWidth": "112px",
      "wordmarkDigitalWidth": "72px",
      "markPrint": "5mm",
      "lockupPrintWidth": "28mm"
    }
  },
  "asset": {
    "og": {
      "width": 1200,
      "height": 630
    },
    "icon": {
      "faviconViewBox": "0 0 64 64",
      "appViewBox": "0 0 512 512",
      "maskableSafeZone": "Mark remains inside the central 66.7 percent circle"
    }
  },
  "motion": {
    "durationFast": "160ms",
    "durationBase": "220ms",
    "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  }
}
